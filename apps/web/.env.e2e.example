# Optional. Copy to apps/web/.env.e2e to override Playwright E2E defaults (see e2e/support/env.ts).
# Supabase keys are read from `supabase status -o env` when unset, so a running local stack needs no config.

E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Must match WEB_ORIGIN in supabase/functions/.env.e2e.
E2E_BASE_URL=http://localhost:3000

# Shared user signed in by the setup project (created on the local stack if missing).
E2E_USER_EMAIL=e2e-user@stackprep.test
E2E_USER_PASSWORD=e2e-password-not-a-secret

# Fake Inngest event API started by global setup; must match INNGEST_DEV in supabase/functions/.env.e2e.
E2E_INNGEST_PORT=8289

# Test-only keyring for seeding encrypted OpenAI keys; must match OPENAI_KEY_ENCRYPTION_KEYS in
# supabase/functions/.env.e2e (version 1 active).
E2E_OPENAI_KEY_ENCRYPTION_KEYS=1:hzoD/xxTZycp8U3IFrR+9ZyasS7CgdWxAmYmqzvH+tY=
