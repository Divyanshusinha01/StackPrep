# Copy to .env.local for local development. Set the same keys in Vercel project settings.

# Required (webEnvSchema). Local values come from `supabase start` / `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (webSentryEnvSchema). SENTRY_ORG/PROJECT/AUTH_TOKEN are build-time only, for source map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# GitHub sign-in is configured in Supabase Auth (see supabase/.env.example), not here.

# GitHub App (webGithubAppEnvSchema). Slug only, used to build the install link.
# Repository access only; separate from the GitHub OAuth App used for sign-in.
# In the App settings, turn on "Request user authorization (OAuth) during installation" (otherwise GitHub
# sends no code) and set the Callback URL to <web origin>/github/callback. With that option on, GitHub
# disables the Setup URL and redirects installs and updates to the Callback URL instead.
NEXT_PUBLIC_GITHUB_APP_SLUG=
