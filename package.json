{
  "name": "stackprep",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @stackprep/web dev",
    "dev:functions": "supabase functions serve --env-file supabase/functions/.env",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://127.0.0.1:54321/functions/v1/inngest --no-discovery",
    "test:functions": "deno test --allow-env --allow-read=packages/code-parser/grammars --config supabase/functions/deno.json supabase/functions",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions",
    "lint:functions": "deno lint supabase/functions",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "test:db": "supabase test db",
    "test:db:concurrency": "deno test --allow-env --allow-net --config supabase/functions/deno.json supabase/tests/concurrency",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e:install": "pnpm --filter @stackprep/web e2e:install",
    "e2e:stack:up": "supabase start && supabase functions serve --env-file supabase/functions/.env.e2e",
    "e2e:stack:down": "supabase stop",
    "test:e2e": "pnpm --filter @stackprep/web test:e2e",
    "test:e2e:ui": "pnpm --filter @stackprep/web test:e2e:ui",
    "check": "pnpm typecheck && pnpm typecheck:functions && pnpm lint && pnpm test && pnpm test:functions && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "supabase": "^2.119.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
