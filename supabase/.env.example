# Copy to supabase/.env; read by the Supabase CLI for `env(...)` values in config.toml.
# In hosted Supabase, set these in Dashboard > Authentication > Providers > GitHub instead.

# GitHub OAuth App (user sign-in only), callback URL: <SUPABASE_URL>/auth/v1/callback.
# This is NOT the GitHub App used for repository access (see supabase/functions/.env.example).
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
