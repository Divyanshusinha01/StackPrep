# Copy to supabase/functions/.env for `pnpm dev:functions` (local development).
# In production, copy to supabase/functions/.env.production WITHOUT the "Local development only"
# block below and run `supabase secrets set --env-file supabase/functions/.env.production`.

# Required (edgeEnvSchema).
WEB_ORIGIN=http://localhost:3000

# Supabase (edgeSupabaseEnvSchema): SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
# Injected automatically by the Edge runtime; the CLI ignores SUPABASE_* keys in env files, so do not set them here.

# Inngest (inngestEnvSchema). Required by `workspaces` (sends events) and `inngest` (serves the
# repository analysis function at {SUPABASE_URL}/functions/v1/inngest). The `inngest` function also
# needs the GitHub App variables below. For local development run `pnpm dev:inngest` and keep the
# "Local development only" block at the end of this file.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI (openAIEnvSchema). Required by `inngest` (deep analysis, interview planning, reports, and
# repository memory embeddings) and `interviews` (mints short-lived Realtime voice credentials,
# evaluates answers, and embeds search_repository queries; the key itself never reaches the browser).
OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-6.1-sol
OPENAI_EVALUATION_MODEL=gpt-6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Must work inside the WebRTC voice session with server_vad; gpt-live-transcribe and gpt-transcribe do not.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-6-luna
# Only change to a model that natively outputs 1536-dimensional vectors (repository_memory.embedding
# is vector(1536)). Output is never truncated; a mismatching model fails embedding and search falls
# back to keyword results.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Report model, separate from OPENAI_EVALUATION_MODEL so either can be resized alone.
OPENAI_REPORT_MODEL=gpt-6-luna
# Reasoning effort per task: default (omit the parameter), none, minimal, low, medium, or high.
# Hidden reasoning tokens dominate latency; use "default" for a model that rejects the parameter.
# Deep analysis uses the planning effort.
OPENAI_PLANNING_REASONING_EFFORT=medium
OPENAI_EVALUATION_REASONING_EFFORT=low
OPENAI_REPORT_REASONING_EFFORT=low
OPENAI_VISION_REASONING_EFFORT=low

# GitHub App (githubAppEnvSchema). Also required by `interviews` (get_file reads at the pinned commit).
# GITHUB_APP_PRIVATE_KEY must be PKCS#8 (-----BEGIN PRIVATE KEY-----);
# GitHub issues PKCS#1 keys, so convert first: openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem
# Store the PEM on one line with newlines escaped as \n.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Sentry (edgeSentryEnvSchema). Optional: an empty SENTRY_DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Local development only. Never set these as production secrets: they would point Inngest at a
# machine that does not exist in production.
# Functions run inside Docker, where localhost is the container, so the Dev Server on the host is
# reached through host.docker.internal.
INNGEST_DEV=http://host.docker.internal:8288
# Without this the SDK registers the container-internal URL (localhost:8081), which the Dev Server
# cannot call, so no step ever runs.
INNGEST_SERVE_HOST=http://127.0.0.1:54321
