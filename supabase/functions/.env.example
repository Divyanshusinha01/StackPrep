# Copy to supabase/functions/.env for `pnpm dev:functions -- --env-file supabase/functions/.env`.
# In production, set these with `supabase secrets set --env-file supabase/functions/.env`.

# Required (edgeEnvSchema).
WEB_ORIGIN=http://localhost:3000

# Supabase (edgeSupabaseEnvSchema): SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
# Injected automatically by the Edge runtime; the CLI ignores SUPABASE_* keys in env files, so do not set them here.

# Inngest (inngestEnvSchema). Required by `workspaces` (sends events) and `inngest` (serves the
# repository analysis function at {SUPABASE_URL}/functions/v1/inngest). The `inngest` function also
# needs the GitHub App variables below. For local development run the Inngest Dev Server and set
# INNGEST_DEV=1 so events and step calls stay local.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# OpenAI (openAIEnvSchema).
OPENAI_API_KEY=

# GitHub App (githubAppEnvSchema). GITHUB_APP_PRIVATE_KEY must be PKCS#8 (-----BEGIN PRIVATE KEY-----);
# GitHub issues PKCS#1 keys, so convert first: openssl pkcs8 -topk8 -nocrypt -in app.pem -out app-pkcs8.pem
# Store the PEM on one line with newlines escaped as \n.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Sentry (edgeSentryEnvSchema).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
